<script>
  function initSlideshow() {
    const images = ["./kapal.jpg", "./excavator.jpg", "./gudang.jpg"];
    let currentIndex = 0;
    let slideshowInterval: ReturnType<typeof setInterval> | null = null;

    const img = document.getElementById("image") as HTMLImageElement | null;
    const dots = [
      document.getElementById("dot-0"),
      document.getElementById("dot-1"),
      document.getElementById("dot-2"),
    ];

    if (!img) {
      console.warn("[Hero] #image element not found; skipping slideshow.");
      return;
    }

    // Bersihkan interval lama (penting saat View Transitions)
    if ((window as any).__heroSlideshowInterval) {
      clearInterval((window as any).__heroSlideshowInterval);
    }

    function updateDots(activeIndex: number) {
      dots.forEach((dot, i) => {
        if (!dot) return;
        dot.classList.toggle("fill-black", i === activeIndex);
        dot.classList.toggle("fill-gray-300", i !== activeIndex);
      });
    }

    function showImage(index: number) {
      if (!img) return;
      currentIndex = index;
      img.onload = () => img.classList.remove("opacity-0");
      img.src = images[index];
      // Handle cached image — onload tidak akan fire
      if (img.complete) img.classList.remove("opacity-0");
      updateDots(index);
    }

    function changeImage() {
      if (!img) return;
      img.classList.add("opacity-0");
      setTimeout(() => {
        showImage((currentIndex + 1) % images.length);
      }, 1000);
    }

    function startInterval() {
      slideshowInterval = setInterval(changeImage, 4000);
      (window as any).__heroSlideshowInterval = slideshowInterval;
    }

    // Klik dot untuk pindah slide manual
    dots.forEach((dot, i) => {
      dot?.addEventListener("click", () => {
        if (i === currentIndex) return;
        // Reset timer agar tidak loncat terlalu cepat setelah klik manual
        if (slideshowInterval) clearInterval(slideshowInterval);
        img.classList.add("opacity-0");
        setTimeout(() => {
          showImage(i);
          startInterval();
        }, 1000);
      });
    });

    showImage(0);
    startInterval();
  }

  document.addEventListener("DOMContentLoaded", initSlideshow);
  document.addEventListener("astro:page-load", initSlideshow);
</script>
